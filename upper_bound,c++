#include <bits/stdc++.h>
using namespace std;

// for upper bound youncan write 
// up = upper_bound(arr.begin(),arr.end(),x) - arr.begin();
void pattern(vector<int>& arr,int n,int x){
    int ans = n;
    int low = 0;
    int high = n-1;
    while(low <= high){
        int mid = low + (high - low)/2;
        if(arr[mid] > x){
            ans = mid;
            high = mid - 1;
        }
        else{
            low = mid + 1;
        }
    }
    cout<<ans;
}

int main() {
    int n;
    cin>>n;
    vector<int>arr(n);
    for(int i =0;i<n;i++){
        cin>>arr[i];
    }
    int x;
    cin>>x;
    pattern(arr,n,x);
}
