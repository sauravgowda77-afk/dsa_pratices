{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run Absolute",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/C",
                "g++ -g \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" && \"${fileDirname}\\${fileBasenameNoExtension}.exe\" < \"${fileDirname}\\input.txt\" > \"${fileDirname}\\output.txt\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "detail": "Uses full paths to find input/output files."
        }
    ]
}